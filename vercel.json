{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/webhook", "dest": "/api/webhook" },
    { "src": "/api/capture", "dest": "/api/webhook" },
    { "src": "/admin", "dest": "/api/webhook" },
    { "src": "/c/(.*)", "dest": "/api/webhook" },
    { "src": "/", "dest": "/api/webhook" }
  ]
}
